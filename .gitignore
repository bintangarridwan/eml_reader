ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent others from using a different version.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used in a clean env, lock file might be regenerated.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be tracked.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be tracked.
# pdm.lock

# virtualenv
#   Typically, the name of the virtual env directory is .venv, venv, or env
.venv/
venv/
ENV/
env/

